{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "annotations": {
          "deprecated.daemonset.template.generation": "3"
        },
        "name": "egress-backup",
        "namespace": "rtl-egress"
      },
      "spec": {
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "rtl-egress",
            "role": "backup"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rtl-egress",
              "role": "backup"
            }
          },
          "spec": {
            "containers": [
              {
                "env": [
                  {
                    "name": "ROLE",
                    "value": "backup"
                  }
                ],
                "image": "docker.io/library/rtl-egress:20260913-nonpreempt",
                "imagePullPolicy": "Never",
                "livenessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "/app/egress.py",
                      "ready"
                    ]
                  },
                  "failureThreshold": 3,
                  "initialDelaySeconds": 60,
                  "periodSeconds": 20,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "name": "egress",
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "/app/egress.py",
                      "ready"
                    ]
                  },
                  "failureThreshold": 3,
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "300m",
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "48Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "add": [
                      "NET_ADMIN"
                    ],
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/keys",
                    "name": "keys",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/config",
                    "name": "settings",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirstWithHostNet",
            "hostNetwork": true,
            "nodeSelector": {
              "kubernetes.io/hostname": "rtl-pro6000d"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 10,
            "tolerations": [
              {
                "effect": "NoSchedule",
                "key": "rtl.ai/externally-managed",
                "operator": "Equal",
                "value": "true"
              }
            ],
            "volumes": [
              {
                "name": "keys",
                "secret": {
                  "defaultMode": 256,
                  "secretName": "wg-backup"
                }
              },
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "egress-settings"
                },
                "name": "settings"
              }
            ]
          }
        },
        "updateStrategy": {
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          },
          "type": "RollingUpdate"
        }
      }
    },
