      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "created-at-shim"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "created-at-shim"
            }
          },
          "spec": {
            "containers": [
              {
                "image": "docker.io/library/created-at-shim:latest",
                "imagePullPolicy": "Never",
                "name": "shim",
                "ports": [
                  {
                    "containerPort": 30001,
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "periodSeconds": 5,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": 30001
                  },
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File"
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "nodeSelector": {
              "kubernetes.io/hostname": "rtl-control"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 30
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "new-api-ingress",
        "namespace": "new-api"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "new-api-ingress"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "new-api-ingress"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "nginx",
                  "-c",
                  "/config/nginx.conf",
                  "-g",
                  "daemon off;"
                ],
                "image": "docker.io/library/rtl-new-api-ingress:20260913",
                "imagePullPolicy": "Never",
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "/bin/sh",
                        "-c",
                        "p=$(cat /tmp/nginx.pid); nginx -c /config/nginx.conf -s quit; while kill -0 \"$p\" 2>/dev/null; do sleep 1; done"
                      ]
                    }
                  }
                },
                "name": "proxy",
                "ports": [
                  {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 2,
                  "httpGet": {
                    "path": "/api/status",
                    "port": 3000,
                    "scheme": "HTTP"
                  },
                  "periodSeconds": 2,
                  "successThreshold": 1,
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/config",
                    "name": "config",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "nodeSelector": {
              "kubernetes.io/hostname": "rtl-control"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {},
            "terminationGracePeriodSeconds": 120,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "new-api-ingress"
                },
                "name": "config"
              }
            ]
          }
        }
      }
    },
