        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "rtl-tekton-bridge"
          }
        },
        "strategy": {
          "type": "Recreate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "rtl-tekton-bridge"
            }
          },
          "spec": {
            "containers": [
              {
                "command": [
                  "python3",
                  "/app/bridge.py"
                ],
                "image": "docker.io/library/rtl-tekton-runtime@sha256:ed6625c4230fa46d33b78ac0f55da51f2a21f69dc7a511acd24799fcada682a2",
                "imagePullPolicy": "Never",
                "name": "bridge",
                "resources": {
                  "limits": {
                    "cpu": "250m",
                    "memory": "128Mi"
                  },
                  "requests": {
                    "cpu": "10m",
                    "memory": "32Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "runAsGroup": 65532,
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/secrets/worker",
                    "name": "worker-token",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "nodeSelector": {
              "kubernetes.io/hostname": "rtl-control"
            },
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "fsGroup": 65532,
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccount": "rtl-tekton-bridge",
            "serviceAccountName": "rtl-tekton-bridge",
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "name": "worker-token",
                "secret": {
                  "defaultMode": 288,
                  "secretName": "rtl-worker-client"
                }
              }
            ]
          }
        }
      }
