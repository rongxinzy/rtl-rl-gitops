    {
      "apiVersion": "tekton.dev/v1",
      "kind": "Pipeline",
      "metadata": {
        "name": "rtl-l20-experiment-v1",
        "namespace": "rtl-pipelines"
      },
      "spec": {
        "finally": [
          {
            "name": "record",
            "params": [
              {
                "name": "job-id",
                "value": "$(params.job-id)"
              },
              {
                "name": "run-uid",
                "value": "$(context.pipelineRun.uid)"
              }
            ],
            "taskRef": {
              "kind": "Task",
              "name": "rtl-l20-record-v1"
            },
            "timeout": "2m0s"
          }
        ],
        "params": [
          {
            "name": "job-id",
            "type": "string"
          }
        ],
        "results": [
          {
            "description": "",
            "name": "comparison",
            "value": "$(tasks.compare.results.proof)"
          },
          {
            "description": "",
            "name": "outcome",
            "value": "$(tasks.compare.results.outcome)"
          }
        ],
        "tasks": [
          {
            "name": "baseline",
            "params": [
              {
                "name": "job-id",
                "value": "$(params.job-id)"
              },
              {
                "name": "run-uid",
                "value": "$(context.pipelineRun.uid)"
              }
            ],
            "retries": 1,
            "taskRef": {
              "kind": "Task",
              "name": "rtl-l20-baseline-v1"
            },
            "timeout": "20m0s"
          },
          {
            "name": "training",
            "params": [
              {
                "name": "job-id",
                "value": "$(params.job-id)"
              },
              {
                "name": "run-uid",
                "value": "$(context.pipelineRun.uid)"
              }
            ],
            "retries": 1,
            "runAfter": [
              "baseline"
            ],
            "taskRef": {
              "kind": "Task",
              "name": "rtl-l20-training-v1"
            },
            "timeout": "50m0s"
          },
          {
            "name": "candidate",
            "params": [
              {
                "name": "job-id",
                "value": "$(params.job-id)"
              },
              {
                "name": "run-uid",
                "value": "$(context.pipelineRun.uid)"
              }
            ],
            "retries": 1,
            "runAfter": [
              "training"
            ],
            "taskRef": {
              "kind": "Task",
              "name": "rtl-l20-candidate-v1"
            },
            "timeout": "20m0s"
          },
          {
            "name": "compare",
            "params": [
              {
                "name": "job-id",
                "value": "$(params.job-id)"
              },
              {
                "name": "run-uid",
                "value": "$(context.pipelineRun.uid)"
              }
            ],
            "retries": 1,
            "runAfter": [
              "candidate"
            ],
            "taskRef": {
              "kind": "Task",
              "name": "rtl-l20-compare-v1"
            },
            "timeout": "20m0s"
          }
        ]
      }
    }
  ]
