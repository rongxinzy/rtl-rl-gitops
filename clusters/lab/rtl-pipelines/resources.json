      "kind": "ValidatingAdmissionPolicy",
      "metadata": {
        "name": "rtl-tekton-fixed-pipeline"
      },
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Equivalent",
          "namespaceSelector": {},
          "objectSelector": {},
          "resourceRules": [
            {
              "apiGroups": [
