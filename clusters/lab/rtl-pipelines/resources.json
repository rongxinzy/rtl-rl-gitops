        "validations": [
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (has(dyn(object).spec.pipelineRef) && dyn(object).spec.pipelineRef.name == 'rtl-l20-experiment-v1' && !has(dyn(object).spec.pipelineRef.resolver))",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (!has(dyn(object).spec.pipelineSpec) && !has(dyn(object).spec.taskRunSpecs) && !has(dyn(object).spec.workspaces))",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (dyn(object).spec.params.size() == 1 && dyn(object).spec.params[0].name == 'job-id' && dyn(object).spec.params[0].value.matches('^l20-[0-9a-f]{24}$'))",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (dyn(object).metadata.name == 'rtl-' + dyn(object).spec.params[0].value)",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (dyn(object).spec.taskRunTemplate.serviceAccountName == 'rtl-experiment')",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (dyn(object).spec.taskRunTemplate.podTemplate.nodeSelector['kubernetes.io/hostname'] == 'rtl-control')",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (!has(dyn(object).spec.taskRunTemplate.podTemplate.volumes) && !has(dyn(object).spec.taskRunTemplate.podTemplate.imagePullSecrets))",
            "message": "Bridge may create only the fixed RTL experiment graph"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:rtl-pipelines:rtl-tekton-bridge' || (dyn(object).spec.taskRunTemplate.podTemplate == {'nodeSelector':dyn({'kubernetes.io/hostname':'rtl-control'}),'securityContext':dyn({'fsGroup':dyn(65532),'runAsUser':dyn(65532),'runAsGroup':dyn(65532),'runAsNonRoot':dyn(true),'seccompProfile':dyn({'type':'RuntimeDefault'})})})",
            "message": "Bridge may create only the fixed RTL experiment graph"
          }
        ]
      }
