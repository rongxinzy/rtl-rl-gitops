    {
      "apiVersion": "v1",
      "data": {
        "download_ranges.py": "#!/usr/bin/env python3\n\"\"\"Bounded ranged GGUF transfer; atomic range journal and final pinned SHA256.\"\"\"\nimport concurrent.futures as cf,hashlib,json,os,pathlib,subprocess,threading,time,urllib.parse,fcntl\nroot=pathlib.Path(os.environ.get('RTL_BACKUP_ROOT','/root/rtl-rl/backup-glm'));m=json.loads(pathlib.Path(os.environ.get('RTL_MANIFEST',str(root/'model-manifest.json'))).read_text());out=root/'models'/m['revision'];out.mkdir(parents=True,exist_ok=True)\n_lock=(out/'download.lock').open('a');fcntl.flock(_lock,fcntl.LOCK_EX|fcntl.LOCK_NB)\nproxy=os.environ.get('HTTPS_PROXY','');lock=threading.Lock();chunk=64*1024*1024\n\ndef sha(p):\n h=hashlib.sha256()\n with p.open('rb') as f:\n  for b in iter(lambda:f.read(8*1024*1024),b''):h.update(b)\n return h.hexdigest()\ndef atomic(p,x):\n t=p.with_suffix(p.suffix+'.tmp');t.write_text(json.dumps(x));t.replace(p)\nstates={};jobs=[]\nfor f in m['files']:\n p=out/pathlib.Path(f['path']).name\n if p.exists():\n  if p.stat().st_size!=f['size'] or sha(p)!=f['sha256']:raise RuntimeError('existing final invalid '+p.name)\n  continue\n part=p.with_suffix('.gguf.part');journal=p.with_suffix('.ranges.json')\n if journal.exists():s=json.loads(journal.read_text())\n else:\n  prefix=part.stat().st_size if part.exists() else 0\n  if prefix>f['size']:raise RuntimeError('oversized partial')\n  s={'prefix':prefix,'done':[],'size':f['size'],'sha256':f['sha256']};atomic(journal,s)\n if s['size']!=f['size'] or s['sha256']!=f['sha256']:raise RuntimeError('manifest changed')\n fd=os.open(part,os.O_RDWR|os.O_CREAT,0o644);os.ftruncate(fd,f['size']);states[p.name]=(s,journal,fd,p,part,f)\n for start in range(s['prefix'],f['size'],chunk):\n  if start not in s['done']:jobs.append((p.name,start,min(start+chunk,f['size'])-1))\n\ndef get(job):\n name,start,end=job;s,journal,fd,p,part,f=states[name];temp=out/f'.{name}.{start}.chunk';source=m[\"download_source\"];assert source[\"provider\"]==\"modelscope\";url=f\"https://modelscope.cn/api/v1/models/{source['repo']}/repo?\"+urllib.parse.urlencode({\"Revision\":source[\"revision\"],\"FilePath\":f[\"path\"]})\n for attempt in range(8):\n  r=subprocess.run(['curl','-fsSL',*(['--proxy',proxy] if proxy else []),'--range',f'{start}-{end}','--limit-rate',os.environ.get('RTL_DOWNLOAD_PER_WORKER','600K'),'--connect-timeout','20','--max-time','600','--speed-time','90','--speed-limit','1024','-o',str(temp),'-w','%{http_code}',url],capture_output=True,text=True)\n  if r.returncode==0 and r.stdout=='206' and temp.stat().st_size==end-start+1:\n   with temp.open('rb') as inp:\n    pos=start\n    for b in iter(lambda:inp.read(4*1024*1024),b''):\n     while b:\n      n=os.pwrite(fd,b,pos);b=b[n:];pos+=n\n   os.fdatasync(fd)\n   with lock:\n    s['done'].append(start);atomic(journal,s)\n   temp.unlink();print(json.dumps({'file':name,'range_end':end,'bytes':end-start+1,'time':time.time()}),flush=True);return\n  print(json.dumps({'file':name,'start':start,'attempt':attempt,'curl':r.returncode,'status':r.stdout[-3:]}),flush=True);time.sleep(min(30,attempt*5+2))\n raise RuntimeError('range incomplete '+name+str(start))\ntry:\n with cf.ThreadPoolExecutor(max_workers=int(os.environ.get('RTL_DOWNLOAD_WORKERS','12'))) as pool:list(pool.map(get,jobs))\n for s,j,fd,p,part,f in states.values():\n  os.fsync(fd);os.close(fd)\n  if sha(part)!=f['sha256']:raise RuntimeError('SHA256 mismatch '+p.name)\n  part.replace(p)\n atomic(out/'verification.json',{'revision':m['revision'],'files':m['files'],'download_source':m['download_source'],'sha256_verified':True,'completed_unix':time.time()})\n print('All GGUF shards verified',flush=True)\nfinally:\n for _,_,fd,*_ in states.values():\n  try:os.close(fd)\n  except OSError:pass\n",
        "model-manifest.json": "{\n  \"repo\": \"unsloth/GLM-5.3-Flash-GGUF\",\n  \"revision\": \"621d456e93e926e4b52f85cff5f634358c1828f9\",\n  \"files\": [\n    {\n      \"path\": \"UD-IQ1_S/GLM-5.3-Flash-UD-IQ1_S-00001-of-00003.gguf\",\n      \"size\": 9429859,\n      \"sha256\": \"e0e7133e1075232471cd6c7cb392fac4c841e051cd1f7015ed9e04d811e0efd6\"\n    },\n    {\n      \"path\": \"UD-IQ1_S/GLM-5.3-Flash-UD-IQ1_S-00002-of-00003.gguf\",\n      \"size\": 49621122496,\n      \"sha256\": \"b99c4dd929601884ff95d9ddeb581a5ef93fd281c37c162e48b2981bf23c0830\"\n    },\n    {\n      \"path\": \"UD-IQ1_S/GLM-5.3-Flash-UD-IQ1_S-00003-of-00003.gguf\",\n      \"size\": 43456692608,\n      \"sha256\": \"9bb0ff754968d588793d795c715cc2a7d5292280ff9d0df46b7e1edd57da34a1\"\n    }\n  ],\n  \"download_source\": {\n    \"provider\": \"modelscope\",\n    \"repo\": \"unsloth/GLM-5.3-Flash-GGUF\",\n    \"revision\": \"a12294d5e5f37ddd2159d173cab6df6016f6dfbc\",\n    \"sha256_matches_hf\": true\n  }\n}\n"
