    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Application",
      "metadata": {
        "name": "rtl-lab",
        "namespace": "argocd"
      },
      "spec": {
        "project": "rtl-lab",
        "source": {
          "repoURL": "https://github.com/rongxinzy/rtl-rl-gitops.git",
          "targetRevision": "main",
          "path": "bootstrap",
          "directory": {
            "recurse": false,
            "include": "*.json"
          }
        },
        "destination": {
          "server": "https://kubernetes.default.svc",
          "namespace": "argocd"
        },
        "syncPolicy": {
          "automated": {
            "enabled": true,
            "selfHeal": true,
            "prune": false,
            "allowEmpty": false
          },
          "syncOptions": [
            "ServerSideApply=true",
            "DisableClientSideApplyMigration=true",
            "RespectIgnoreDifferences=true",
            "FailOnSharedResource=true"
          ],
          "retry": {
            "limit": 5,
            "backoff": {
              "duration": "5s",
              "factor": 2,
              "maxDuration": "1m"
            }
          }
        },
        "ignoreDifferences": [
          {
            "group": "admissionregistration.k8s.io",
            "kind": "MutatingWebhookConfiguration",
            "jqPathExpressions": [
              ".webhooks[]?.clientConfig.caBundle"
            ]
          },
          {
            "group": "admissionregistration.k8s.io",
            "kind": "ValidatingWebhookConfiguration",
            "jqPathExpressions": [
              ".webhooks[]?.clientConfig.caBundle"
            ]
          },
          {
            "group": "rbac.authorization.k8s.io",
            "kind": "ClusterRole",
            "jqPathExpressions": [
              "select(.aggregationRule != null) | .rules"
            ]
          },
          {
            "group": "",
            "kind": "PersistentVolumeClaim",
            "jsonPointers": [
              "/spec/volumeName"
            ]
          },
          {
            "group": "rtl.rongxin.ai",
            "kind": "InferenceSchedule",
            "name": "glm-nightly",
            "namespace": "rtl-system",
            "jsonPointers": [
              "/spec/jobId",
              "/status"
            ]
          }
        ]
      }
    },
